rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Enforce that a user can only read, write, or list documents belonging to their own UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Sub-collections under the user document inherit the same strict isolation boundary
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
